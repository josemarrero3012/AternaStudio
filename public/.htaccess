# Aterna Studio — export estático para Hostinger.
# Sustituye a next.config.ts > headers(), incompatible con output: 'export'.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  <FilesMatch "^(aterna-symbol-light|aterna-wordmark-light|aterna-mark|aterna-lockup|aterna-lockup-light|icon|apple-icon|og)\.(webp|png|jpg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Los fotogramas del recorrido de la portada, un año: la segunda visita
  # ya no los descarga. Van en una carpeta con versión (public/journey/v1):
  # si se vuelven a renderizar, cambia la carpeta (ver lib/journey/config.ts).
  <FilesMatch "^(journey|depth)-[0-9]{3}\.webp$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Iconos de luz de «Estudio» (public/estudio/v1), un año: van en carpeta
  # con versión (ver components/PillarArt.tsx).
  <FilesMatch "^pillar-[0-9]\.(webm|mp4|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Nubes de puntos de las escenas de «Estudio» (public/estudio/v3), igual.
  <FilesMatch "^(state-[abc]|attr|path)\.bin$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Modelo del asistente (public/semantic): el motor es WebAssembly y el
# navegador solo lo compila al vuelo si llega con su tipo. Un mes de caché
# para el motor y el modelo: pesan mucho y casi nunca cambian.
AddType application/wasm .wasm
AddType video/webm .webm
AddType video/mp4 .mp4
<IfModule mod_headers.c>
  <FilesMatch "\.(wasm|onnx)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Compresión de texto (HTML, CSS, JS, JSON, SVG). Las imágenes y los vídeos
# ya van comprimidos. Si el servidor no tiene el módulo, no hace nada.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/wasm
</IfModule>

# Next.js exporta cada ruta como <ruta>.html, PERO cuando una ruta tiene
# subrutas (p. ej. /servicios con /servicios/seo) también crea una carpeta
# <ruta>/. Sin las dos líneas siguientes, Apache redirige /servicios ->
# /servicios/ (la carpeta), no encuentra index.html y devuelve 403.
#
#   - MultiViews off: no negociar variantes automáticamente.
#   - DirectorySlash off: NO redirigir /servicios a /servicios/ cuando existe
#     la carpeta; así la regla de reescritura puede servir /servicios.html.
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Si la ruta pedida NO es un archivo real pero existe <ruta>.html, servirlo.
  # (Se quita la condición !-d a propósito: queremos servir /servicios.html
  # aunque exista la carpeta /servicios/.) Las carpetas reales con index.html
  # —p. ej. /ejemplos/reformas-sevilla/— no tienen un .html gemelo, así que
  # esta regla no las toca y Apache sirve su index.html con normalidad.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Índice por defecto para las carpetas que sí lo tienen (ejemplos, raíz).
DirectoryIndex index.html

# Página 404 propia (Next la exporta como 404.html).
ErrorDocument 404 /404.html
