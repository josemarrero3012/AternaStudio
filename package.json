{
  "name": "aterna-web",
  "version": "1.0.0",
  "private": true,
  "description": "Web de Aterna Studio (Next.js, exportación estática para Hostinger).",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/fetch-semantic.mjs",
    "build": "next build",
    "start": "node scripts/serve-out.mjs 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "playwright-core": "1.64.1",
    "typescript": "^5.6"
  }
}
